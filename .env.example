# Bu dosyayı .env adıyla kopyalayın ve anahtarları doldurun. .env asla depoya eklenmez.

# Google AI Studio anahtarı (ücretsiz katman): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Sonraki aşamalar için (şimdilik boş kalabilir)
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

